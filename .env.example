# Environment Variables - Copy this to .env.local and fill in your values

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production

# Google OAuth (optional). The button on /login and /signup renders only when
# BOTH are set. Authorised redirect URI in the Google Cloud console:
#   http://localhost:3000/api/auth/callback/google   (and the https one in prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (optional)
# APPLE_CLIENT_ID is the Services ID (e.g. com.example.imposter.web), NOT the
# App ID. APPLE_CLIENT_SECRET is not a static string: Apple wants an ES256 JWT
# signed with your .p8 private key, and it expires after at most 6 months, so
# it has to be regenerated on a schedule:
#   node scripts/generate-apple-secret.mjs --help
# Apple rejects http:// and localhost redirect URLs, so this provider only
# works on a deployed https host. Return URL:
#   https://your-domain/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Database - PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/imposter_game?schema=public"
# Alternative SQLite for local dev:
# DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Google AdSense (optional) — the 160x600 rails in the gutters either side of
# the content box on the landing, dashboard, auth and shop screens.
#
# All three must be set for a live ad: with no client id the adsbygoogle script
# is never loaded, and in development the rails render a dashed "AD 160x600"
# placeholder instead so the reserved space is visible. In production an
# unconfigured rail renders nothing at all.
#
# NEXT_PUBLIC_ADSENSE_CLIENT is the publisher id from the AdSense console
# (ca-pub-<16 digits>); the two slot ids come from the ad units you create
# there — make them display units sized 160x600, one per side, so reporting can
# tell the two rails apart. Note ads only appear on wide screens (>=1400px on
# /dashboard, >=1680px elsewhere): below that there is no gutter to sit in.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_LEFT=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_RIGHT=0000000000

# Simulated players (testing). Adds a SIMULATE PLAYERS button to the lobby
# that fills it with bots so one person can start and play a whole round.
#
# Defaults to ON in development and OFF in production, because on a public
# deployment this is a way to stuff every open lobby with fake players. Set
# explicitly to override either way — "true" turns it on in production (for a
# smoke test), "false" turns it off in development.
# ALLOW_BOT_PLAYERS=true
