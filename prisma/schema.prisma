// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  avatar        String?
  password      String?   // null for OAuth users
  emailVerified DateTime?

  // ── Wallet (spec §9, §11) ──
  // The authoritative coin balance. Only the server writes it: rewards are
  // credited in finalizeResults, spends go through purchaseCosmetic(). The
  // client is never trusted with a number here.
  coins         Int       @default(0)
  // Equipped loadout as JSON — three nullable slots, see EquippedCosmetics.
  // A column rather than a table because it is one row's worth of state that
  // is always read and written whole.
  equipped      String?
  // Set once, when a guest's localStorage progress is folded into a new
  // account (§11's claim-your-account prompt). Guards against replaying the
  // same claim to mint coins.
  claimedGuestAt DateTime?

  cosmetics     CosmeticOwnership[]
  accounts      Account[]
  sessions      Session[]
  presets       Preset[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One row per cosmetic a player owns (§10). A table rather than a JSON blob
// because the unique constraint is what makes buying the same item twice
// impossible even if two requests race.
model CosmeticOwnership {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  acquiredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Preset {
  id               String   @id @default(cuid())
  name             String
  normalVideoUrl   String
  imposterVideoUrl String
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
}

model GameHistory {
  id         String   @id @default(cuid())
  roomCode   String
  imposterId String
  imposterName String
  winningSide String   // 'crew' | 'imposter'
  playerCount Int
  players    String   // JSON snapshot as string for SQLite
  createdAt  DateTime @default(now())
}
